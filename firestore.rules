rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Containers collection (Peti Kemas JAPARA)
    match /containers/{containerId} {
      allow read: if true;
      allow create: if isValidId(containerId)
        && request.resource.data.containerNumber is string
        && request.resource.data.containerNumber.size() <= 20
        && request.resource.data.grossWeight is number
        && request.resource.data.size is number;
      allow update: if isValidId(containerId)
        && request.resource.data.containerNumber is string
        && request.resource.data.grossWeight is number;
      allow delete: if isValidId(containerId);
    }

    // Vessels collection (Jadwal Sandar Kapal)
    match /vessels/{vesselId} {
      allow read: if true;
      allow create: if isValidId(vesselId)
        && request.resource.data.vesselName is string
        && request.resource.data.vesselName.size() <= 150;
      allow update: if isValidId(vesselId);
      allow delete: if isValidId(vesselId);
    }

    // Gate transactions collection (Pemeriksaan Gerbang Truck)
    match /gateTransactions/{gateId} {
      allow read: if true;
      allow create: if isValidId(gateId)
        && request.resource.data.truckNumber is string
        && request.resource.data.truckNumber.size() <= 50;
      allow update: if isValidId(gateId);
      allow delete: if isValidId(gateId);
    }
  }
}
